# This file IS committed to git (see the `!.env` exception in .gitignore). It exists
# only so `$env/static/public` has exports to resolve when no .env.local is present —
# the unconfigured build that the E2E sweep and screenshot scripts rely on.
#
# Keep both values empty here. Real keys belong in .env.local (gitignored, never
# committed) — putting them here instead means a routine `git add .` ships them.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
